---
import { site, siteUrl } from '@/lib/site'

import '@/styles/tailwind.css'

interface Props {
  title: string
  description?: string
  path: string
  noindex?: boolean
}

let {
  title,
  description = site.description,
  path,
  noindex = false,
} = Astro.props

let canonical = new URL(path, siteUrl).href
let ogImage = `${siteUrl}/opengraph-image.png`
let isHome = path === '/'

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  givenName: 'Hernán',
  familyName: 'Arica',
  url: siteUrl,
  image: ogImage,
  jobTitle: site.jobTitle,
  email: `mailto:${site.email}`,
  worksFor: {
    '@type': 'Organization',
    name: 'Spotter',
    url: 'https://www.gospotter.app',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Buenos Aires',
    addressCountry: 'AR',
  },
  alumniOf: { '@type': 'EducationalOrganization', name: 'Escuela Da Vinci' },
  knowsAbout: site.keywords.slice(4),
  sameAs: [site.links.github, site.links.linkedin, site.links.x],
}
---

<html lang="es" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={site.name} />
    <meta name="author" content={site.fullName} />
    <meta name="creator" content={site.fullName} />
    <meta name="keywords" content={site.keywords.join(',')} />
    <meta
      name="robots"
      content={
        noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'
      }
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />

    <meta property="og:type" content={isHome ? 'profile' : 'website'} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.title} />
    {isHome && (
      <>
        <meta property="profile:first_name" content="Hernán" />
        <meta property="profile:last_name" content="Arica" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.xHandle} />
    <meta name="twitter:creator" content={site.xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#18181b"
    />
    <!-- Va inline y bloqueante para aplicar el tema antes del primer pintado.
         Guarda el tema solo si difiere del sistema: si coincide, el sitio vuelve
         a seguir al SO. Los meta theme-color siguen al sistema, no al toggle,
         así que se copian de --edge (tailwind.css) cada vez que cambia el tema
         o el ancho -->
    <script is:inline>
      ;(() => {
        let root = document.documentElement
        let dark = matchMedia('(prefers-color-scheme: dark)')
        let wide = matchMedia('(min-width: 40rem)')

        function storedTheme() {
          try {
            return localStorage.getItem('theme')
          } catch {
            return null
          }
        }

        function applyTheme() {
          let system = dark.matches ? 'dark' : 'light'
          let stored = storedTheme()
          if (stored === system) {
            try {
              localStorage.removeItem('theme')
            } catch {}
          }
          let theme = stored === 'light' || stored === 'dark' ? stored : system
          root.classList.toggle('dark', theme === 'dark')
          root.style.colorScheme = theme
        }

        function syncThemeColor() {
          let color = getComputedStyle(root).getPropertyValue('--edge').trim()
          if (!color) return
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((meta) => meta.setAttribute('content', color))
        }

        applyTheme()
        syncThemeColor()
        // El CSS puede no estar cargado todavía cuando corre el script
        addEventListener('DOMContentLoaded', syncThemeColor)
        dark.addEventListener('change', applyTheme)
        wide.addEventListener('change', syncThemeColor)
        new MutationObserver(syncThemeColor).observe(root, {
          attributes: true,
          attributeFilter: ['class'],
        })
      })()
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personJsonLd)}
    />
  </head>
  <body class="flex h-full bg-(--edge)">
    <slot />
  </body>
</html>
