---
import { getImage } from 'astro:assets'

import { Footer } from '@/components/Footer'
import { Header } from '@/components/Header'
import avatarImage from '@/images/avatar.jpg'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { site } from '@/lib/site'

interface Props {
  title?: string
  description?: string
  path: string
  noindex?: boolean
}

let { title, description, path, noindex } = Astro.props

let avatar = await getImage({ src: avatarImage, width: 128, format: 'webp' })
let pathname = Astro.url.pathname.replace(/(.)\/$/, '$1')
---

<BaseLayout
  title={title ? `${title} - ${site.name}` : site.title}
  description={description}
  path={path}
  noindex={noindex}
>
  <div class="flex w-full">
    <div
      aria-hidden="true"
      class="scroll-progress fixed inset-x-0 top-0 z-60 h-0.5 origin-left bg-linear-to-r from-teal-400 via-teal-500 to-emerald-400"
    >
    </div>
    <div class="fixed inset-0 flex justify-center sm:px-8">
      <div class="flex w-full max-w-7xl lg:px-8">
        <div
          class="w-full bg-white ring-1 ring-zinc-100 dark:bg-zinc-900 dark:ring-zinc-300/20"
        >
        </div>
      </div>
    </div>
    <div class="relative flex w-full flex-col">
      <Header client:load pathname={pathname} avatarSrc={avatar.src} />
      <main class="flex-auto">
        <slot />
      </main>
      <Footer />
    </div>
    <!-- Safari 26 ignora theme-color y tiñe sus barras con el background-color
         del elemento fijo que toca cada borde (opaco, de al menos 3px y casi
         todo el ancho; si tiene opacity lo ignora) -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-40 h-1 bg-(--edge)"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 bottom-0 z-40 h-1 bg-(--edge)"
    >
    </div>
  </div>
</BaseLayout>

<script>
  import Lenis from 'lenis'

  import 'lenis/dist/lenis.css'

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new Lenis({ autoRaf: true, lerp: 0.1, anchors: true })
  }
</script>
