---
import { SimpleLayout } from '@/components/SimpleLayout'
import { StackShowcase } from '@/components/StackShowcase'
import SiteLayout from '@/layouts/SiteLayout.astro'
---

<SiteLayout
  title="Stack"
  description="Las tecnologías que uso para productos, datos y automatizaciones con IA, y por qué elijo cada una."
  path="/stack"
>
  <SimpleLayout
    title="Mi caja de herramientas."
    intro="Del frontend a la base de datos, de los datos a la automatización. Este es el stack que uso todos los días y por qué elijo cada pieza."
  >
    <StackShowcase client:load />
  </SimpleLayout>
</SiteLayout>
