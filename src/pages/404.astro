---
import { Button } from '@/components/Button'
import { Container } from '@/components/Container'
import SiteLayout from '@/layouts/SiteLayout.astro'
---

<!-- Sin Lenis: su CSS pone height:auto en <html> y la página dejaría de
     ocupar toda la pantalla (el contenido no quedaría centrado) -->
<SiteLayout
  title="Página no encontrada"
  path="/404"
  noindex
  smoothScroll={false}
>
  <Container className="flex h-full items-center pt-16 sm:pt-32">
    <div class="flex flex-col items-center">
      <p class="text-base font-semibold text-zinc-400 dark:text-zinc-500">
        404
      </p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
        Página no encontrada
      </h1>
      <p class="mt-4 text-base text-zinc-600 dark:text-zinc-400">
        Lo siento, no encontré la página que estás buscando.
      </p>
      <Button href="/" variant="secondary" className="mt-4">
        Volver al inicio
      </Button>
    </div>
  </Container>
</SiteLayout>
