---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { ArrowUpRight } from 'lucide-react'

import { Stagger, StaggerItem } from '@/components/Reveal'
import { SimpleLayout } from '@/components/SimpleLayout'
import imageBezzaPay from '@/images/projects/bezzapay.jpg'
import imageCuentasClaras from '@/images/projects/cuentasclaras.webp'
import imageIndigoHub from '@/images/projects/indigohub.jpg'
import imageMetaAlign from '@/images/projects/metaalign.webp'
import imageMomenrise from '@/images/projects/momenrise.webp'
import imageOmPersonal from '@/images/projects/ompersonal.jpg'
import imageSpotter from '@/images/projects/spotter.webp'
import SiteLayout from '@/layouts/SiteLayout.astro'

interface Project {
  name: string
  role: string
  description: string
  stack: Array<string>
  image: ImageMetadata
  links: Array<{ href: string; label: string }>
}

const projects: Array<Project> = [
  {
    name: 'Spotter',
    role: 'CTO & Cofounder',
    description:
      'Una misma app en dos partes. La plataforma empareja a personas que entrenan en el mismo gimnasio y horario para sostener la constancia: matching, agenda de entrenamientos, confirmación de sesiones y notificaciones, sobre una arquitectura que puede crecer sin que mantenerla se vuelva un problema. La landing, con lista de espera para personas y gimnasios, es la que usamos para validar la demanda antes del MVP.',
    stack: ['TypeScript', 'React', 'Astro', 'Supabase', 'GCP', 'IA'],
    image: imageSpotter,
    links: [{ href: 'https://www.gospotter.app', label: 'gospotter.app' }],
  },
  {
    name: 'Momenrise',
    role: 'Creador · Proyecto personal',
    description:
      'Web app gratuita de hábitos que se instala en el celular desde el navegador, sin pasar por las tiendas. Registro con un toque, timer o cantidad, frecuencias flexibles, rachas que se pueden pausar, estadísticas, recordatorios push e integración con asistentes de IA vía MCP.',
    stack: ['Next.js', 'Astro', 'Supabase', 'PWA', 'MCP / IA'],
    image: imageMomenrise,
    links: [
      { href: 'https://app.momenrise.com', label: 'Abrir la app' },
      { href: 'https://www.momenrise.com', label: 'momenrise.com' },
    ],
  },
  {
    name: 'Cuentas Claras',
    role: 'Full Stack · Uso privado del cliente',
    description:
      'App web de finanzas del hogar para un cliente. Maneja cuentas y tarjetas con cuotas, presupuestos por categoría, metas, deudas y movimientos recurrentes, con roles por miembro, tutoriales guiados y exportación a Excel.',
    stack: ['React', 'TypeScript', 'Supabase', 'Tailwind CSS', 'Zustand'],
    image: imageCuentasClaras,
    links: [],
  },
  {
    name: 'MetaAlign',
    role: 'Full Stack',
    description:
      'Plataforma de planificación ortodóntica para clínicas y laboratorios. Incluye el website, MetaAlign Cloud para gestionar casos, planificación y créditos, y un visor 3D en el navegador para revisar y aprobar tratamientos.',
    stack: ['Next.js', 'React', 'Supabase', 'Visor 3D'],
    image: imageMetaAlign,
    links: [
      { href: 'https://www.meta-align.com', label: 'Website' },
      { href: 'https://cloud.meta-align.com', label: 'Cloud' },
      { href: 'https://viewer.meta-align.com', label: 'Viewer 3D' },
    ],
  },
  {
    name: 'IndigoHub',
    role: 'Full Stack Developer · Indigo',
    description:
      'Plataforma interna de Indigo. Lideré su desarrollo con un equipo de 3 personas, definiendo arquitectura, stack y procesos; optimicé costos de infraestructura y sumé ETLs y automatizaciones.',
    stack: ['React', 'GCP', 'Supabase', 'BigQuery', 'ETLs'],
    image: imageIndigoHub,
    links: [
      {
        href: 'https://kickhub.indigohubs.tech/login',
        label: 'indigohubs.tech',
      },
    ],
  },
  {
    name: 'OM Personal English',
    role: 'Full Stack',
    description:
      'Migración de un portal de inglés gratuito con 27 años de historia y más de 68.000 usuarios a una plataforma nueva: cursos de A1 a C2 con audio, ejercicios y exámenes automatizados, migrando el contenido sección por sección sin cortar el servicio.',
    stack: ['Next.js', 'Supabase', 'Tailwind CSS', 'Migración de datos'],
    image: imageOmPersonal,
    links: [
      { href: 'https://www.ompersonal.com.ar', label: 'ompersonal.com.ar' },
    ],
  },
  {
    name: 'Bezza Pay',
    role: 'Full Stack',
    description:
      'Website de un proveedor de servicios de pago autorizado por el BCRA (ex Taca Taca), con landings y herramientas como el simulador de cobros, comisiones y cuotas.',
    stack: ['Astro', 'React', 'Tailwind CSS', 'TypeScript'],
    image: imageBezzaPay,
    links: [{ href: 'https://www.bezzapay.com.ar', label: 'bezzapay.com.ar' }],
  },
]

// Los emprendimientos propios van primero y con su propio bloque
const ventureNames = ['Spotter', 'Momenrise']
const sections = [
  {
    title: 'Emprendimientos',
    intro: 'Productos propios que construyo y hago crecer.',
    items: projects.filter((project) => ventureNames.includes(project.name)),
  },
  {
    title: 'Trabajo para clientes y empresas',
    intro: 'Plataformas, migraciones y sitios que llevé a producción.',
    items: projects.filter((project) => !ventureNames.includes(project.name)),
  },
]
---

<SiteLayout
  title="Proyectos"
  description="Plataformas, productos y sitios que construí para clientes, empresas y mi propio startup."
  path="/projects"
>
  <SimpleLayout
    title="Productos que construí, de la idea a producción."
    intro="Mis emprendimientos propios y una selección de los proyectos más importantes en los que trabajé: plataformas internas, migraciones a gran escala y sitios para empresas."
  >
    {sections.map((section) => (
      <section class="mb-20 last:mb-0">
        <h2 class="text-lg font-semibold text-zinc-800 dark:text-zinc-100">
          {section.title}
        </h2>
        <p class="mt-1 mb-10 text-sm text-zinc-600 dark:text-zinc-400">
          {section.intro}
        </p>
        <Stagger
          as="ul"
          role="list"
          stagger={0.12}
          className="grid grid-cols-1 gap-x-12 gap-y-16 md:grid-cols-2"
        >
          {section.items.map((project) => {
            // Los proyectos de clientes privados no tienen link: la imagen no es clickeable
            const href = project.links[0]?.href
            const Cover = href ? 'a' : 'div'

            return (
              <StaggerItem as="li" className="flex flex-col">
                <Cover
                  {...(href
                    ? { href, target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                  class="group block overflow-hidden rounded-2xl bg-zinc-100 shadow-sm ring-1 ring-zinc-900/5 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-teal-500/10 dark:bg-zinc-800 dark:ring-white/10"
                >
                  <Image
                    src={project.image}
                    alt={`Captura de ${project.name}`}
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 1024px) 31rem, (min-width: 768px) 45vw, 100vw"
                    quality={95}
                    class="aspect-16/10 w-full object-cover object-top transition duration-300 group-hover:scale-[1.04]"
                  />
                  {href && (
                    <span class="sr-only">
                      Visitar {project.name} (se abre en una pestaña nueva)
                    </span>
                  )}
                </Cover>
                <h3 class="mt-6 text-base font-semibold text-zinc-800 dark:text-zinc-100">
                  {project.name}
                </h3>
                <p class="mt-1 text-xs font-medium text-zinc-400 dark:text-zinc-500">
                  {project.role}
                </p>
                <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
                  {project.description}
                </p>
                <ul role="list" class="mt-4 flex flex-wrap gap-2">
                  {project.stack.map((tech) => (
                    <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                      {tech}
                    </li>
                  ))}
                </ul>
                <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group/link inline-flex items-center gap-1 text-sm font-medium text-teal-500 transition hover:text-teal-600 dark:text-teal-400 dark:hover:text-teal-300"
                    >
                      {link.label}
                      <ArrowUpRight className="h-4 w-4 transition group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" />
                      <span class="sr-only">
                        (se abre en una pestaña nueva)
                      </span>
                    </a>
                  ))}
                </div>
              </StaggerItem>
            )
          })}
        </Stagger>
      </section>
    ))}
  </SimpleLayout>
</SiteLayout>
